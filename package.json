{
  "name": "unlockopen-slides",
  "version": "2.0.0",
  "type": "module",
  "description": "Standalone presentation tool with UnlockOpen styling - powered by Reveal.js",
  "bin": {
    "unlockopen-slides": "./src/cli/index.js"
  },
  "scripts": {
    "setup": "node scripts/setup-vendor.js",
    "postinstall": "npm run setup && npm run build:tokens",
    "build:tokens": "node build-tokens.js",
    "build": "node src/cli/index.js build",
    "dev": "node src/cli/index.js dev",
    "serve": "node src/cli/index.js serve",
    "init": "node src/cli/index.js init",
    "legacy:build": "node build.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "marked": "^11.1.1",
    "mustache": "^4.2.0",
    "open": "^10.0.0",
    "reveal.js": "^5.0.4",
    "unlockopen-design-tokens": "github:unlockopen/unlockopen-design-tokens",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "presentations",
    "slides",
    "reveal.js",
    "markdown"
  ],
  "author": "UnlockOpen",
  "license": "MIT"
}
